# Copiá este archivo como ".env" (local) y cargá los mismos valores como
# Environment Variables en el proyecto de Vercel — nunca subas el ".env" real.

# API key de Resend (resend.com) — se genera gratis en su dashboard.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# A dónde llegan las consultas del formulario.
CONTACT_TO_EMAIL=hola@inplant.com.ar

# Remitente del email. Mientras el dominio inplant.com.ar no esté
# verificado en Resend, dejá el de pruebas de abajo (funciona igual).
CONTACT_FROM_EMAIL=Inplant Web <onboarding@resend.dev>
